local multTrack, multKnob = makeToggleRow(14, "Tap Speed", "x" .. MULTIPLIER .. " per tap (~50 CPS)")
local autoTrack, autoKnob = makeToggleRow(58, "Auto Tapper", "Taps " .. AUTO_TAP_CPS .. " CPS at last spot")

----------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------
local function syncPanel()
	panel.Position = UDim2.new(
		bubble.Position.X.Scale, bubble.Position.X.Offset,
		bubble.Position.Y.Scale, bubble.Position.Y.Offset + 54
	)
end
syncPanel()

local function setToggleVisual(track, knob, state)
	local info = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(track, info, {
		BackgroundColor3 = state and Color3.fromRGB(0, 200, 120) or Color3.fromRGB(58, 58, 72),
	}):Play()
	TweenService:Create(knob, info, {
		Position = state and UDim2.new(0, 27, 0.5, -11) or UDim2.new(0, 3, 0.5, -11),
	}):Play()
end

local function setEnabled(state)
	enabled = state
	setToggleVisual(multTrack, multKnob, state)
	bubble.TextColor3 = (state or autoTapperEnabled)
		and Color3.fromRGB(120, 255, 190)
		or Color3.fromRGB(255, 255, 255)
	notify(state and ("Tap Speed x" .. MULTIPLIER .. " — ON (fast)")
	            or ("Tap Speed x" .. MULTIPLIER .. " — OFF"), state)
end

local function setAutoTapper(state)
	autoTapperEnabled = state
	setToggleVisual(autoTrack, autoKnob, state)
	bubble.TextColor3 = (state or enabled)
		and Color3.fromRGB(120, 255, 190)
		or Color3.fromRGB(255, 255, 255)
	notify(state and "Auto Tapper — ON" or "Auto Tapper — OFF", state)
end

multTrack.Activated:Connect(function() setEnabled(not enabled) end)
autoTrack.Activated:Connect(function() setAutoTapper(not autoTapperEnabled) end)

----------------------------------------------------------------
-- OPEN / CLOSE PANEL
----------------------------------------------------------------
local panelOpen = false

local function setPanel(open)
	panelOpen = open
	syncPanel()

	if open then
		panel.Visible = true
		TweenService:Create(panel, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			GroupTransparency = 0,
		}):Play()
		TweenService:Create(pscale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1,
		}):Play()
	else
		TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			GroupTransparency = 1,
		}):Play()
		TweenService:Create(pscale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Scale = 0.9,
		}):Play()
		task.delay(0.2, function()
			if not panelOpen then panel.Visible = false end
		end)
	end
end

----------------------------------------------------------------
-- DRAG + TAP ON THE ⚡ BUTTON  (touch only)
----------------------------------------------------------------
local dragging  = false
local dragged   = false
local dragStart = nil
local startPos  = nil
local activeTouch = nil

bubble.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	dragging     = true
	dragged      = false
	dragStart    = input.Position
	startPos     = bubble.Position
	activeTouch  = input
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	if activeTouch and input ~= activeTouch then return end

	local delta = input.Position - dragStart
	if not dragged and delta.Magnitude > 8 then
		dragged = true
	end
	if dragged then
		bubble.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
		syncPanel()
	end
end)

UIS.InputEnded:Connect(function(input)
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	if activeTouch and input ~= activeTouch then return end

	dragging    = false
	activeTouch = nil
	if not dragged then
		setPanel(not panelOpen)
	end
end)

----------------------------------------------------------------
-- TOUCH-ONLY REPLAY  (~50 CPS)
----------------------------------------------------------------
local function sendTouchTap(x, y)
	simulatedUntil = os.clock() + PRESS_GAP + 0.02
	pcall(function()
		VIM:SendTouchEvent(x, y, Enum.UserInputState.Begin, false, game)
		task.wait(PRESS_GAP)
		VIM:SendTouchEvent(x, y, Enum.UserInputState.End, false, game)
	end)
end

local function pointInside(obj, x, y)
	if not obj.Visible then return false end
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function startAutoTapper()
	if autoTapperRunning then return end
	autoTapperRunning = true
	task.spawn(function()
		while autoTapperRunning and autoTapperEnabled do
			if lastTapX and lastTapY then
				sendTouchTap(lastTapX, lastTapY)
			end
			task.wait(AUTO_TAP_GAP)
		end
		autoTapperRunning = false
	end)
end

local lastTap = 0

UIS.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	if gameProcessed then return end
	if os.clock() < simulatedUntil then return end   -- ignore our own virtual taps

	local x, y = input.Position.X, input.Position.Y
	if pointInside(bubble, x, y) then return end
	if panelOpen and pointInside(panel, x, y) then return end

	if autoTapperEnabled then
		lastTapX, lastTapY = x, y
		startAutoTapper()
	end

	if enabled then
		local now = os.clock()
		if now - lastTap < DEBOUNCE then return end
		lastTap = now

		task.spawn(function()
			for i = 2, MULTIPLIER do
				if not enabled then break end
				sendTouchTap(x, y)
				task.wait(i <= BURST_COUNT and BURST_GAP or REPLAY_GAP)
			end
		end)
	end
end)

notify("Tap Speed x" .. MULTIPLIER .. " loaded — tap ⚡", true)