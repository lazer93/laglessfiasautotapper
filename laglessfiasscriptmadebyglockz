----------------------------------------------------------------
-- DEEP ADMIN-SYSTEM SCAN
----------------------------------------------------------------
local function matchesAny(name, keywords)
	local lower = name:lower()
	for _, kw in ipairs(keywords) do
		if lower:find(kw, 1, true) then return kw end
	end
	return nil
end

local function deepScanAdminSystems()
	local found = { systems = {}, remotes = {}, guis = {} }

	local services = {
		game:GetService("ReplicatedStorage"),
		game:GetService("ReplicatedFirst"),
	}
	for sysName, names in pairs(STAFF_CONFIG.KnownSystems) do
		local matched = false
		for _, svc in ipairs(services) do
			for _, name in ipairs(names) do
				local inst = svc:FindFirstChild(name)
				if inst then
					table.insert(found.systems, { name = sysName, instance = inst, path = svc.Name .. "." .. name })
					matched = true
					break
				end
			end
			if matched then break end
		end
	end

	local containers = {
		game:GetService("ReplicatedStorage"),
		game:GetService("ReplicatedFirst"),
		game:GetService("Workspace"),
		game:GetService("Lighting"),
	}

	local scanned = 0
	for _, container in ipairs(containers) do
		local ok, descendants = pcall(function() return container:GetDescendants() end)
		if ok and descendants then
			for _, desc in ipairs(descendants) do
				scanned += 1
				if scanned % 400 == 0 then task.wait() end

				local kw = matchesAny(desc.Name, STAFF_CONFIG.AdminKeywords)
				if kw then
					local cls = desc.ClassName
					if cls == "RemoteEvent" or cls == "RemoteFunction" then
						table.insert(found.remotes, { name = desc.Name, class = cls, instance = desc })
					elseif cls == "ScreenGui" or cls == "Folder" or cls == "ModuleScript" or cls == "Configuration" then
						local already = false
						for _, sys in ipairs(found.systems) do
							if sys.instance == desc then already = true break end
						end
						for _, g in ipairs(found.guis) do
							if g.instance == desc then already = true break end
						end
						if not already then
							table.insert(found.guis, { name = desc.Name, class = cls, instance = desc })
						end
					end
				end
			end
		end
	end

	return found
end

----------------------------------------------------------------
-- HIGHER-UP DETECTION
----------------------------------------------------------------
local function hasAdminTool(plr)
	local function checkContainer(container)
		if not container then return nil end
		for _, item in ipairs(container:GetChildren()) do
			if matchesAny(item.Name, STAFF_CONFIG.ToolKeywords) then return item end
		end
		return nil
	end
	local found = checkContainer(plr:FindFirstChild("Backpack"))
	if found then return found end
	if plr.Character then
		found = checkContainer(plr.Character)
	end
	return found
end

local function getStaffLevel(plr)
	if STAFF_CONFIG.FlagCreator then
		if game.CreatorType == Enum.CreatorType.User and plr.UserId == game.CreatorId then
			return "owner", "Game Creator"
		end
		if game.CreatorType == Enum.CreatorType.Group then
			local ok, rank = pcall(function() return plr:GetRankInGroup(game.CreatorId) end)
			if ok and rank and rank >= 255 then return "owner", "Group Owner" end
		end
	end

	local lname = plr.Name:lower()
	for _, name in ipairs(STAFF_CONFIG.KnownStaff) do
		if lname == name:lower() then return "admin", "Known Staff" end
	end

	for _, gid in ipairs(STAFF_CONFIG.GroupIds) do
		local ok, rank = pcall(function() return plr:GetRankInGroup(gid) end)
		if ok and rank and rank > 0 then
			if rank >= 250 then return "owner", "Group rank " .. rank
			elseif rank >= 200 then return "admin", "Group rank " .. rank
			elseif rank >= 100 then return "mod", "Group rank " .. rank
			else return "staff", "Group rank " .. rank end
		end
	end

	if STAFF_CONFIG.CheckRobloxGroup then
		local ok, rank = pcall(function() return plr:GetRankInGroup(1) end)
		if ok and rank and rank > 0 then return "admin", "Roblox Staff" end
	end

	if plr.Team and plr.Team.Name then
		local tn = plr.Team.Name:lower()
		for _, kw in ipairs(STAFF_CONFIG.TeamKeywords) do
			if tn:find(kw, 1, true) then
				if tn:find("owner", 1, true) then return "owner", "Team: " .. plr.Team.Name
				elseif tn:find("admin", 1, true) then return "admin", "Team: " .. plr.Team.Name
				elseif tn:find("mod", 1, true) then return "mod", "Team: " .. plr.Team.Name
				else return "staff", "Team: " .. plr.Team.Name end
			end
		end
	end

	local tool = hasAdminTool(plr)
	if tool then return "staff", "Has tool: " .. tool.Name end

	return nil
end

local function scanPlayer(plr)
	if plr == player then return end
	local level, reason = getStaffLevel(plr)
	if not level then return end

	local oldLevel = knownStaff[plr.UserId]
	local isNew    = oldLevel ~= level
	knownStaff[plr.UserId] = level

	if isNew then
		local style = STAFF_STYLES[level]
		local suffix = reason and (" [" .. reason .. "]") or ""
		notify(level:upper() .. " — " .. plr.DisplayName .. " (@" .. plr.Name .. ")" .. suffix, true, style)
	end

	if staffAlertEnabled then
		if plr.Character then
			applyStaffHighlight(plr)
			if isNew or not staffBillboards[plr.UserId] then
				applyStaffBillboard(plr, level)
			end
		end

		if not staffTracked[plr.UserId] then
			staffTracked[plr.UserId] = true
			plr.CharacterAdded:Connect(function()
				if not staffAlertEnabled then return end
				if not knownStaff[plr.UserId] then return end
				task.wait(0.3)
				if staffAlertEnabled and knownStaff[plr.UserId] then
					applyStaffHighlight(plr)
					applyStaffBillboard(plr, knownStaff[plr.UserId])
				end
			end)
		end
	end
end

local function countStaffInServer()
	local n = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and knownStaff[p.UserId] then n += 1 end
	end
	return n
end

local function scanAllPlayers(warnIfEmpty)
	for _, plr in ipairs(Players:GetPlayers()) do
		scanPlayer(plr)
	end
	if not warnIfEmpty then return end

	local n = countStaffInServer()
	if n == 0 and not hasWarnedNoStaff then
		hasWarnedNoStaff = true
		notify("No administrators in this server", false, EMPTY_STYLE)
	elseif n > 0 then
		hasWarnedNoStaff = false
	end
end

----------------------------------------------------------------
-- DEEP SCAN + REPORT
----------------------------------------------------------------
local function runDeepScan()
	if deepScanRunning then return end
	deepScanRunning = true
	lastDeepScan = os.clock()

	local ok, result = pcall(deepScanAdminSystems)
	if not ok or not result then
		deepScanRunning = false
		notify("Deep scan failed — try again", false, EMPTY_STYLE)
		return
	end

	for _, sys in ipairs(result.systems) do
		if not detectedSystems[sys.name] then
			detectedSystems[sys.name] = true
			notify("Admin system: " .. sys.name, true, SYSTEM_STYLE)
		end
	end

	if #result.remotes > 0 then
		local seen = {}
		for _, r in ipairs(result.remotes) do
			if not seen[r.name] then
				seen[r.name] = true
				detectedSystems["remote:" .. r.name] = true
				notify("Admin remote: " .. r.name .. " (" .. r.class .. ")", true, SYSTEM_STYLE)
			end
		end
	end

	if #result.guis > 0 then
		local seen = {}
		for _, g in ipairs(result.guis) do
			if not seen[g.name] then
				seen[g.name] = true
				if not detectedSystems["gui:" .. g.name] then
					detectedSystems["gui:" .. g.name] = true
					notify("Admin panel: " .. g.name .. " (" .. g.class .. ")", true, SYSTEM_STYLE)
				end
			end
		end
	end

	if #result.systems == 0 and #result.remotes == 0 and #result.guis == 0 then
		if not detectedSystems["__none__"] then
			detectedSystems["__none__"] = true
			notify("No admin systems detected in this game", false, EMPTY_STYLE)
		end
	else
		detectedSystems["__none__"] = nil
	end

	deepScanRunning = false
end

