--=============================================================
--  TAP x25 + AUTO TAPPER  —  MOBILE / iPAD  —  TOUCH ONLY
--  • tap multiplier: burst a few super-fast taps, then finish
--    the rest at ~50 CPS (faster than a standard auto-clicker)
--  • Auto Tapper: continuously taps wherever you last tapped,
--    at ~50 CPS, until you toggle it off
--  • touch-only replays via SendTouchEvent (no mouse)
--  • draggable ⚡ button + smooth top-RIGHT notifications
--=============================================================

local Players      = game:GetService("Players")
local UIS          = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local VIM          = game:GetService("VirtualInputManager")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==================== CONFIG ============================
local MULTIPLIER    = 25        -- total taps per physical tap (was 10)
local BURST_COUNT   = 6         -- first N taps are ultra fast (was 3)
local BURST_GAP     = 0.003     -- ~333 CPS burst (was 0.008)
local REPLAY_GAP    = 0.02      -- ~50 CPS   (was 0.05 / 20 CPS)
local PRESS_GAP     = 0.001     -- Begin → End per simulated tap (was 0.002)
local DEBOUNCE      = 0.03      -- ignore duplicate physical taps
local AUTO_TAP_CPS  = 50        -- continuous auto-tapper speed (was 20)
local AUTO_TAP_GAP  = 1 / AUTO_TAP_CPS
--=========================================================

local enabled           = false
local autoTapperEnabled = false
local autoTapperRunning = false
local lastTapX, lastTapY = nil, nil
local simulatedUntil    = 0

