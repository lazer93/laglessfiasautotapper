	task.spawn(function()
		scanAllPlayers(false)
		task.wait(STAFF_CONFIG.InitialGraceTime)
		scanAllPlayers(true)
		runDeepScan()

		while staffScanRunning and staffAlertEnabled do
			task.wait(STAFF_CONFIG.ScanInterval)
			scanAllPlayers(true)
			if os.clock() - lastDeepScan >= STAFF_CONFIG.DeepScanInterval then
				runDeepScan()
			end
		end
		staffScanRunning = false
	end)
end

local function setStaffCheck(state)
	staffAlertEnabled = state
	setToggleVisual(staffTrack, staffKnob, state)
	refreshBubbleColor()

	if state then
		hasWarnedNoStaff = false
		detectedSystems  = {}
		knownStaff       = {}
		staffTracked     = {}
		notify("Staff Check — ON (deep scanning…)", true)
		startStaffScan()
	else
		notify("Staff Check — OFF", false)
		staffScanRunning = false
		removeAllStaffVisuals()
		knownStaff       = {}
		staffTracked     = {}
		detectedSystems  = {}
		hasWarnedNoStaff = false
	end
end

Players.PlayerAdded:Connect(function(plr)
	if staffAlertEnabled then
		task.wait(0.2)
		scanPlayer(plr)
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	knownStaff[plr.UserId] = nil
	removeStaffHighlight(plr.UserId)
	removeStaffBillboard(plr.UserId)
end)

